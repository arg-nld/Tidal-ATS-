# Tidal ATS Phase 4 scalability configuration
# PostgreSQL
DATABASE_URL=
# After creating the PostgreSQL database, set a connection string such as:
# DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/tidal_ats
PG_POOL_MAX=10
PG_SSL=false
# If your provider uses a certificate your Node runtime cannot validate, explicitly set this to false (not recommended).
PG_SSL_REJECT_UNAUTHORIZED=true

# Resume storage: local for development, s3 for production/object storage
OBJECT_STORAGE_PROVIDER=local
LOCAL_UPLOAD_ROOT=server/data/uploads
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email delivery: choose gmail for Gmail SMTP, or resend for Resend. Queue mode requires DATABASE_URL/PostgreSQL
# Set EMAIL_DELIVERY_MODE=queue only after PostgreSQL has been configured.
EMAIL_DELIVERY_MODE=direct
EMAIL_WORKER_INTERVAL_MS=2000
EMAIL_WORKER_LEASE_MS=300000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MS=750

# Existing settings
EMAIL_PROVIDER=gmail
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
RESEND_API_KEY=
EMAIL_FROM="TIDAL Solutions <your-address@gmail.com>"
# Use your deployed frontend origin in production; localhost is only for local development.
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
COMPANY_NAME=TIDAL Solutions
CORS_ORIGINS=http://localhost:5173

# Resume parsing and AI screening
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend API configuration:
# - Leave VITE_API_BASE_URL unset for same-origin /api (recommended when Express serves the built frontend).
# - For a separately hosted frontend, set this at frontend BUILD time to the deployed backend URL, including /api.
# VITE_API_BASE_URL=https://your-backend.example.com/api
# Optional local development backend port (defaults to 5001). Do not set this on a host that supplies PORT.
# BACKEND_PORT=5001
# Optional Vite development proxy target; defaults to BACKEND_PORT or 5001.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5001
