# Backend
PORT=5000
APP_URL=http://localhost:5173
COMPANY_NAME=Tidal Nexus

# Gemini
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.8-flash

# Resend email delivery
# For local Resend testing, onboarding@resend.dev can only send to the
# email address that owns your Resend account. For real users, verify a
# domain at resend.com/domains and use an address from that domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Tidal Nexus <onboarding@resend.dev>
