# Backend
PORT=5000
APP_URL=http://localhost:5173
COMPANY_NAME=Tidal Nexus
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
TRUST_PROXY=false

# Gemini
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.8-flash

# Resend email delivery
# For local Resend testing, onboarding@resend.dev can only send to the
# email address that owns your Resend account. For real users, verify a
# domain at resend.com/domains and use an address from that domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Tidal Nexus <onboarding@resend.dev>

# Phase 3 reliability
DB_MAX_BACKUPS=10
DB_BACKUP_INTERVAL_MS=300000
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_MS=750
